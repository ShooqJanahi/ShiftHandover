@model IEnumerable<ShiftHandover.Models.Shift>

@{
    ViewBag.Title = "My Shifts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">
    <h2 class="mb-4 text-center">My Shift Activity History</h2>

    <!-- Search Bar for filtering shifts -->
   <form method="get" class="d-flex justify-content-center mb-3" style="max-width: 900px; margin: 0 auto;">
    <input type="text" name="searchTerm" class="form-control me-2"
           placeholder="Search shifts..." value="@Context.Request.Query["searchTerm"]" />

        <select name="statusFilter" class="form-select me-2" style="max-width: 160px;">
            <option value="">All</option>

            @* Active option *@
            @if (Context.Request.Query["statusFilter"] == "Active")
            {
                <option value="Active" selected>Active</option>
            }
            else
            {
                <option value="Active">Active</option>
            }

            @* Closed option *@
            @if (Context.Request.Query["statusFilter"] == "Closed")
            {
                <option value="Closed" selected>Closed</option>
            }
            else
            {
                <option value="Closed">Closed</option>
            }
        </select>



    <button type="submit" class="btn btn-search me-2">Search</button>
    <a href="/Shift/ShiftHistory" class="btn btn-secondary">Clear</a>
</form>


    <hr />

    <!-- If no shifts exist, show info message -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You have no logged activities yet.
        </div>
    }
    else
    {
        <!-- Display shifts in a responsive table -->
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Shift ID</th>
                        <th>Location</th>
                        <th>Shift Type</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Total Manpower</th>
                        <th>Notes</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Model) //Loop through each shift
                    {
                        <tr>
                            <td>@shift.Id</td>
                            <td>@shift.Location</td>
                            <td>@shift.ShiftType</td> <!-- Type of the shift (Morning, Night, etc.) -->
                            <td>@shift.StartTime.ToString("f")</td>
                            <td>@(shift.EndTime.HasValue ? shift.EndTime.Value.ToString("f") : "N/A")</td>

                            <td>@shift.TotalManpower</td>
                            <td>@shift.Notes</td>

                            <!-- Display shift status -->
                            <td>
                                @if (shift.IsClosed)
                                {
                                    <span class="badge badge-success">Closed</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Open</span>
                                }
                            </td>

                            <!-- View Button to see detailed shift info -->
                            <td>
                                <a class="btn btn-primary btn-sm" asp-controller="Shift" asp-action="ViewShift" asp-route-id="@shift.Id">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
